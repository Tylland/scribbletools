{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Linux AMD64",
            "type": "shell",
            "command": "go",
            "args": [
                "build",
                "-ldflags=-s -w",
                "-o",
                "bin/linux/scribbletools-amd64-linux",
                "./cmd/main.go"
            ],
            "options": {
                "env": {
                    "GOOS": "linux",
                    "GOARCH": "amd64"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build Linux Release",
            "type": "shell",
            "command": "go",
            "args": [
                "build",
                "-ldflags=-s -w",
                "-o",
                "bin/linux/scribbletools-amd64-linux",
                "./cmd/main.go"
            ],
            "options": {
                "env": {
                    "GOOS": "linux",
                    "GOARCH": "amd64"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$go"]
        },
        {
            "type": "typescript",
            "tsconfig": "tsconfig.json",
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "tsc: build"
        }
    ]
}