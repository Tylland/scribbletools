{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/main.go",
            "output": "./bin/scribbletools",
            "env": {},
            "args": []
        },
        {
            "name": "Build Linux files",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/main.go",
            "env": {
                "GOOS": "linux",
                "GOARCH": "amd64"
            },
            "args": [],
            "output": "${workspaceFolder}/bin/linux/scribbletools-amd64-linux",
        },
        {
            "name": "Build Windows files",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/main.go",
            "env": {
                "GOOS": "windows",
                "GOARCH": "amd64"
            },
            "args": [],
            "output": "${workspaceFolder}/bin/amd64/scribbletools.exe",
        },
        {
            "name": "Build TypeScript",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "tsc",
            "runtimeArgs": ["--project", "tsconfig.json"],
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Build TS + Go and Launch",
            "configurations": ["Build TypeScript", "Launch"],
            "preLaunchTask": "tsc: build"
        }
    ]
}